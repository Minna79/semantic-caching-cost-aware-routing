# Copy to .env and fill in. Never commit .env.
OPENROUTER_API_KEY=your-key-here

# mock = free offline stand-in model (plumbing only); openrouter = real calls
LLM_BACKEND=mock

# hash = offline stand-in embedder (plumbing only); sentence-transformers = the real multilingual model
EMBEDDING_BACKEND=hash

# Model ids on OpenRouter. Free ids (ending in :free) are billed in the cost table at their tier's list price.
SMALL_MODEL=anthropic/claude-haiku-5.5
LARGE_MODEL=anthropic/claude-sonnet-5.5

# Hard cap on real API calls per run (protects your credits)
MAX_LLM_CALLS=300
TOP_K=4
